    <!--<add name="myConnectionString" connectionString="server=148.72.232.168;database=LFQDB;uid=ahmedshair;password=32129241770ab;"/>-->
    <!--<add name="myConnectionString" connectionString="server=43.255.152.25;database=LFQDB;uid=ahmedshair;password=32129241770ab;"/>-->
