@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var adminName = User?.Identity?.Name;
    var path = (Context.Request.Path.Value ?? "").ToLowerInvariant();
    string Active(string key) => path.Contains(key) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" type="image/png" sizes="64x64" href="~/favicon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png">
    <link rel="icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Content/sweetalert.css" />
    <link rel="stylesheet" href="~/assets/css/admin.css" />

    <script src="~/Scripts/jquery-1.12.4.js"></script>
    <script src="~/Scripts/jquery-ui-1.12.1.js"></script>
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/Scripts/modernizr-2.6.2.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    <script src="~/Scripts/MainFileAdmin.js"></script>
    <script src="~/Scripts/sweetalert.min.js"></script>
    <script src="~/Scripts/Forum.js"></script>

    <style>
        /* Info modal used by Forum.js */
        .modal {
            display: none;
            position: fixed;
            z-index: 1300;
            padding-top: 100px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.4);
        }

        .modal-content {
            background-color: #fff;
            margin: auto;
            padding: 22px;
            width: 90%;
            max-width: 460px;
        }

        .modal .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
            cursor: pointer;
        }

        .modal .close:hover { color: #000; }
    </style>
</head>
<body class="admin-body @(isAuth ? "" : "admin-login")">

<div id="myModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h5 style="text-align:center" id="modelheading"></h5>
            <p style="color: black;" id="modelparagraph"></p>
        </div>
    </div>

    <header class="admin-topbar">
        <div class="admin-topbar-inner">
            <a class="admin-brand" href="/" target="_blank" title="Go to website">
                <img src="~/images/Logo3.png" alt="Learn Quran" />
                <span>Admin <span class="accent">Panel</span></span>
            </a>

            @if (isAuth)
            {
                <ul class="admin-nav">
                    <li class="has-sub @(path.Contains("student") || path.Contains("schedule") || path.Contains("today") ? "active" : "")">
                        <a href="#">Students</a>
                        <ul class="sub">
                            <li><a href="/Admin/GetAllStudents">All Students</a></li>
                            <li><a href="/Admin/GetScheduledStudents">Scheduled</a></li>
                            <li><a href="/Admin/GetUnscheduledStudents">Unscheduled</a></li>
                            <li><a href="/Admin/GetTodaySchedule">Today's Schedule</a></li>
                        </ul>
                    </li>
                    <li class="has-sub @(path.Contains("book") || path.Contains("video") ? "active" : "")">
                        <a href="#">Content</a>
                        <ul class="sub">
                            <li><a href="/Admin/AddBook">Add Book</a></li>
                            <li><a href="/Admin/GetAllBooks">All Books</a></li>
                            <li><a href="/Admin/VideoLessons">Video Lessons</a></li>
                        </ul>
                    </li>
                    <li class="has-sub @(path.Contains("forum") || path.Contains("publish") ? "active" : "")">
                        <a href="#">Forum</a>
                        <ul class="sub">
                            <li><a href="/Admin/ForumMainPage">All Questions</a></li>
                            <li><a href="/Admin/Publish">Publish</a></li>
                            <li><a href="/Admin/UnPublish">UnPublish</a></li>
                        </ul>
                    </li>
                    <li class="@Active("getcontactus")"><a href="/Admin/GetContactUs">Contact</a></li>
                    <li class="@Active("getfeedback")"><a href="/Admin/GetFeedback">Feedback</a></li>
                </ul>

                <div class="admin-user">
                    @if (!string.IsNullOrEmpty(adminName))
                    {
                        <span class="who"><i class="fa fa-user-circle"></i>@adminName</span>
                    }
                    <a class="admin-logout" href="/Admin/Logout"><i class="fa fa-sign-out"></i> Logout</a>
                </div>
            }
        </div>
    </header>

    <main class="admin-content">
        @RenderBody()
    </main>

    <footer class="admin-footer">
        &copy; @DateTime.Now.Year <a href="/" target="_blank">Learn Free Quran</a> &mdash; Admin Panel. All rights reserved.
    </footer>

</body>
</html>
