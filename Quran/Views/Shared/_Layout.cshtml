@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var userName = session?.GetString("name");
    var chapterId = session?.GetString("Chapterid");
    var bookmarkId = session?.GetString("Bookmarkid");

    var seoTitle = ViewBag.Title as string;
    if (string.IsNullOrWhiteSpace(seoTitle)) { seoTitle = "Learn Quran Online with E-Tutor | Free One-on-One Classes"; }
    var seoDesc = ViewBag.Description as string;
    if (string.IsNullOrWhiteSpace(seoDesc)) { seoDesc = "Learn the Holy Quran online for free with qualified e-tutors. Read with translation, study Tajweed, Namaz, Kalmas and Islamic basics, and register in minutes."; }
    var seoKeys = ViewBag.KeyWords as string;
    if (string.IsNullOrWhiteSpace(seoKeys)) { seoKeys = "learn quran online, free quran classes, online quran tutor, read holy quran, tajweed, islamic education"; }
    var req = HttpContextAccessor.HttpContext?.Request;
    var canonicalUrl = req == null ? "/" : $"{req.Scheme}://{req.Host}{req.Path}";
    var ogImage = req == null ? "/apple-touch-icon.png" : $"{req.Scheme}://{req.Host}/apple-touch-icon.png";
}
<!DOCTYPE html>
<html lang="en" style="scroll-behavior: smooth; ">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@seoTitle</title>
    <meta name="description" content="@seoDesc">
    <meta name="keywords" content="@seoKeys">
    <meta name="author" content="Learn Quran with E-Tutor">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="@canonicalUrl">

    <link rel="icon" type="image/png" sizes="64x64" href="~/favicon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png">
    <link rel="icon" href="~/favicon.ico">
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png">

<meta property="og:type" content="website">
    <meta property="og:site_name" content="Learn Quran with E-Tutor">
    <meta property="og:title" content="@seoTitle">
    <meta property="og:description" content="@seoDesc">
    <meta property="og:url" content="@canonicalUrl">
    <meta property="og:image" content="@ogImage">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="@seoTitle">
    <meta name="twitter:description" content="@seoDesc">
    <link rel="stylesheet" href="/assets/css/icons.min.css">
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/animate.min.css">
    <link rel="stylesheet" href="/assets/css/fancybox.min.css">
    <link rel="stylesheet" href="/assets/css/owl.carousel.min.css">
    <link rel="stylesheet" href="/assets/css/jquery.circliful.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="stylesheet" href="/assets/css/responsive.css">

<link rel="stylesheet" href="/assets/css/colors/color3.css" />
    <link rel="stylesheet" href="/assets/css/app.css">

    <link href="https://netdna.bootstrapcdn.com/font-awesome/3.2.1/css/font-awesome.css" rel="stylesheet">
    
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-253330618-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-253330618-1');
    </script>

<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1488654337163312"
            crossorigin="anonymous"></script>

</head>
<body>

<main>
        <header class="nv">
            <div class="nv-inner">
                <a class="nv-brand" href="/" title="Learn Quran with E-Tutor"><img src="~/images/Logo3.png" alt="Learn Quran with E-Tutor"></a>
                <button class="nv-toggle" id="nvToggle" type="button" aria-label="Menu"><i class="fa fa-bars"></i></button>
                <nav class="nv-menu" id="nvMenu">
                    <a href="/">Home</a>
                    <div class="nv-item">
                        <a href="#" class="nv-top">Learn <i class="fa fa-angle-down"></i></a>
                        <div class="nv-sub">
                            <a href="/Quran_Teacher">Quran Teacher</a>
                            <a href="/online_quran_reading">Read Quran</a>
                            <a href="/Video_Lessons">Video Lessons</a>
                            <a href="/Books/AllBooks">Islamic Books</a>
                        </div>
                    </div>
                    <div class="nv-item">
                        <a href="#" class="nv-top">Basic Islam <i class="fa fa-angle-down"></i></a>
                        <div class="nv-sub">
                            <a href="/Six_Kalmas">Read Kalmas</a>
                            <a href="/Namaz">Read Namaz</a>
                            <a href="/Masnoon_Duain">Learn Duain</a>
                            <a href="/Darood">Darood Sharif</a>
                            <a href="/Namaz_e_Janaza">Namaz Janaza</a>
                            <a href="/Due_e_Qunoot">Dua-e-Qunoot</a>
                        </div>
                    </div>
                    <a href="/Home/FeeStructure">Fee Structure</a>
                    <a href="/Registration">Registration</a>
                    <a href="/Forum">Forum</a>
                    @if (!string.IsNullOrEmpty(userName))
                    {
                        if (!string.IsNullOrEmpty(chapterId) && !string.IsNullOrEmpty(bookmarkId))
                        {
                            <a class="nv-cta" href="/quran_reading?ChapterID=@chapterId@bookmarkId">Goto Bookmark</a>
                        }
                        else
                        {
                            <a class="nv-cta" href="#">Goto Bookmark</a>
                        }
                    }
                    else
                    {
                        <a class="nv-cta" href="/User/UserLogin">Login</a>
                    }
                </nav>
            </div>
        </header>
        <script>
            (function () {
                var t = document.getElementById('nvToggle'), m = document.getElementById('nvMenu');
                if (t && m) { t.addEventListener('click', function () { m.classList.toggle('open'); }); }
            })();
        </script>
        <div class="header-search">
            <span class="srch-cls-btn brd-rd5"><i class="fa fa-times"></i></span>
            <form>
                <input type="text" placeholder="Search here...">
                <button type="submit"><i class="fa fa-search"></i></button>
            </form>
        </div>
        <div class="contact-form-model-wrap text-center">
            <span class="model-close"><i class="fa fa-times"></i></span>
            <div class="contact-form-inner">
                <div class="sec-title text-center">
                    <div class="sec-title-inner">
                        <span>Have Question</span>
                        <h3>Send Message</h3>
                    </div>
                </div>
                <div class="contact-form text-center">
                    <form action="#" method="post">
                        <div class="row mrg20">
                            <div class="col-md-6 col-sm-6 col-lg-6">
                                <input type="text" placeholder="Name" id="User_Name" required>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-6">
                                <input type="text" placeholder="Phone" id="User_Phone" required>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-6">
                                <input type="email" placeholder="Email" id="User_email" required>
                            </div>
                            <div class="col-md-6 col-sm-6 col-lg-6">
                                <input type="text" placeholder="Subject" id="subject" required>
                            </div>
                            <div class="col-md-12 col-sm-12 col-lg-12">
                                <textarea placeholder="Message" id="message" required></textarea>
                                <button class="thm-btn brd-rd40" type="submit" id="contactbutton">Contact Us</button>
                            </div>
                        </div>
                    </form>
                    <div class="scl float-right">
                        <a href="#" title="Twitter" target="_blank"><i class="fa fa-twitter"></i></a>
                        <a href="https://www.yahoo.com/" title="Yahoo" target="_blank"><i class="fa fa-yahoo"></i></a>
                        <a href="https://plus.google.com/u/3/110044614813581789939" title="Google Plus" target="_blank"><i class="fa fa-google-plus"></i></a>   
                        <a href="https://play.google.com/store/apps/details?id=com.mstech.learnquranwithtutor&pli=1" title="Android App" target="_blank"><i class="fa fa-android"></i></a>
                        <a href="https://www.facebook.com/Learn-Free-Quran-1338414089559572" title="Facebook" target="_blank"><i class="fa fa-facebook"></i></a>
                    </div>
                </div>
            </div>
        </div>

        @RenderBody()
        <footer class="site-footer">
            <div class="ftr-top">
                <div class="container">
                    <div class="ftr-grid">
                        <div class="ftr-col ftr-brand">
                            <a href="/" title="Learn Quran with E-Tutor"><img class="ftr-logo" src="~/images/Logo3.png" alt="Learn Quran with E-Tutor"></a>
                            <p>Learn the Holy Quran online for free with qualified e-tutors &mdash; Quran reading with translation, Tajweed and the basics of Islam, open to everyone, everywhere.</p>
                            <div class="ftr-social">
                                <a href="https://www.facebook.com/Learn-Free-Quran-1338414089559572/" target="_blank" rel="noopener" title="Facebook"><i class="fa fa-facebook"></i></a>
                                <a href="https://play.google.com/store/apps/details?id=com.mstech.learnquranwithtutor" target="_blank" rel="noopener" title="Android App"><i class="fa fa-android"></i></a>
                                <a href="#" title="Twitter"><i class="fa fa-twitter"></i></a>
                                <a href="#" title="YouTube"><i class="fa fa-youtube-play"></i></a>
                            </div>
                        </div>
                        <div class="ftr-col">
                            <h4>Explore</h4>
                            <ul>
                                <li><a href="/online_quran_reading">Read Quran</a></li>
                                <li><a href="/Quran_Teacher">Quran Teacher</a></li>
                                <li><a href="/Books/AllBooks">Islamic Books</a></li>
                                <li><a href="/Video_Lessons">Video Lessons</a></li>
                                <li><a href="/Forum">Forum</a></li>
                            </ul>
                        </div>
                        <div class="ftr-col">
                            <h4>Basic Islam</h4>
                            <ul>
                                <li><a href="/Six_Kalmas">Six Kalmas</a></li>
                                <li><a href="/Namaz">Learn Namaz</a></li>
                                <li><a href="/Masnoon_Duain">Masnoon Duain</a></li>
                                <li><a href="/Darood">Darood Sharif</a></li>
                                <li><a href="/Namaz_e_Janaza">Namaz-e-Janaza</a></li>
                                <li><a href="/Due_e_Qunoot">Dua-e-Qunoot</a></li>
                            </ul>
                        </div>
                        <div class="ftr-col">
                            <h4>Quick Links</h4>
                            <ul>
                                <li><a href="/Registration">Free Registration</a></li>
                                <li><a href="/Home/FeeStructure">Fee Structure</a></li>
                                <li><a href="/about">About Us</a></li>
                                <li><a href="/contact">Contact Us</a></li>
                                <li><a href="/Students_Terms">Terms &amp; Privacy</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ftr-bottom">
                <div class="container ftr-bottom-inner">
                    <p>&copy; @DateTime.Now.Year Learn Free Quran. All rights reserved.</p>
                    <p>Made with <i class="fa fa-heart"></i> for the sake of Allah.</p>
                </div>
            </div>
        </footer>
    </main>
    <a href="javascript:" id="return-to-top"><i class="icon-chevron-up"></i></a>
    <script src="~/assets/js/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.min.js"></script>
    <script src="~/assets/js/downCount.js"></script>
    <script src="~/assets/js/fancybox.min.js"></script>
    <script src="~/assets/js/isotope.pkgd.min.js"></script>
    <script src="~/assets/js/perfectscrollbar.min.js"></script>
    <script src="~/assets/js/owl.carousel.min.js"></script>
    <script src="~/assets/js/jquery.circliful.min.js"></script>
    <script src="~/assets/js/custom-scripts.js"></script>
    <script src="~/Scripts/MainFile.js"></script>

<script>
        // ===== Scroll to Top ====
        $(window).scroll(function () {
            if ($(this).scrollTop() >= 50) {        // If page is scrolled more than 50px
                $('#return-to-top').fadeIn(200);    // Fade in the arrow
            } else {
                $('#return-to-top').fadeOut(200);   // Else fade out the arrow
            }
        });
        $('#return-to-top').click(function () {      // When arrow is clicked
            $('body,html').animate({
                scrollTop: 0                       // Scroll to top of body
            }, 500);
        });
    </script>
</body>
</html>