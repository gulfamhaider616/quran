@model IEnumerable<Quran.Models.SuraNamesDO>
@{
	ViewBag.Title = "Online Quran Teacher | Learn Quran with E-Tutor";
	ViewBag.Description = "Online Quran Teacher - Learn to read Quran from Online Quran Teacher FREE. People can contact us throughout the wolrd to give us valuable suggestions by using our contact center or online support team.";
	ViewBag.KeyWords = "Quran Teacher, Learn Quran, Read Quran,Quran with Trajuma,Tarjma tul quran, Tajweed,Learn Quran,Learn free quran, learn quran with tutor,learn quran with tutor,Online Quran, Tutor, Quran, Quraan, Coran,Learn Online Quran with Tutor, Learn Islam, Basics of Islam, Online Islam, Online Tutor, Digital Quran, Digital world, digital,Arabic Quran, Arabic, Allah, Muhammad, Quran Teacher, Teacher, Electronic World";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="banner-wrapper">
	<div id="banner" class="box container" >
		<div class="row">
			<div class="col-md-12" style="width:100%;margin:0 auto;overflow-x:auto;">
				<h5 style="text-align:center">Online Quran Reading</h5>
				<span >Read Quran Online: Read the Holy Quran in all available translations including Arabic, English and Urdu translation. Choose from the list to read quran in urdu, read quran in english, read quran in arabic or combined.</span>
				<table class="rest" border="0" style="width: 100%;text-align: center;color: black;border: 1px solid black;font-size: 88%;">
					<thead style="font-weight: 600;background: darksalmon !important;">
						<tr style="color:white;">
							<td>Serial</td>
							<td>Surah Name</td>
							<td>English Name</td>
							<td>Number of Ayats</td>
						</tr>
					</thead>
					<tbody>
						@foreach (var Item in Model)
						{
							<tr>
								<td>@Item.ChapterID</td>
								<td><a href="~/quran_reading?ChapterID=@Item.ChapterID" class="al-quran" style="font-weight: 500;"> @Item.SuraName </a></td>
								<td><a href="~/quran_reading?ChapterID=@Item.ChapterID"> @Item.EnglishName </a></td>
								<td>@Item.TotalVerses</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
</div>
