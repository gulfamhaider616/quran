@model IEnumerable<Quran.Models.SuraNamesDO>
@{
    ViewBag.Title = "Read Quran Online with Translation | Learn Quran with E-Tutor";
    ViewBag.Description = "Read the complete Holy Quran online with English, Urdu and Indonesian translation. Browse all 114 Surahs, listen, learn and bookmark your progress free.";
    ViewBag.KeyWords = "read holy quran, surah list, multilingual translation, urdu tarjuma, listen recitation, digital mushaf, 114 chapters";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="qr-section">
    <div class="container">
        <div class="sec-head">
            <span>Read Quran Online</span>
            <h2>The Holy Quran &mdash; All 114 Surahs</h2>
            <p>Read the Holy Quran in Arabic with English and Urdu translation. Choose any Surah from the list below to start reading, and bookmark your progress.</p>
        </div>

        <div class="qr-list">
            @foreach (var item in Model)
            {
                <a class="qr-item" href="~/quran_reading?ChapterID=@item.ChapterID" title="@item.EnglishName">
                    <span class="qr-num">@item.ChapterID</span>
                    <span class="qr-en">
                        <span class="qr-en-name">@item.EnglishName</span>
                        <span class="qr-verses">@item.TotalVerses verses</span>
                    </span>
                    <span class="qr-ar al-quran">@item.SuraName</span>
                </a>
            }
        </div>
    </div>
</div>
