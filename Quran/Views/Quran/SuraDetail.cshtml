@model Quran.Models.SuraDetailContract
@{
    ViewBag.Title = "Surah Reading with Translation | Learn Quran with E-Tutor";
    ViewBag.Description = "Read any Surah verse by verse with multilingual translation and audio. Bookmark ayahs and continue your recitation anytime, completely free.";
    ViewBag.KeyWords = "surah reading, verse translation, ayat audio, bookmark verse, continue recitation, tafseer meaning";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string suraName = Model.SuraDetail.ChapterID.ToString();
}

<script>
    function togglePlay(id) {
        $("audio").on("play", function () {
            $("audio").not(this).each(function (index, audio) { audio.pause(); });
        });
        var audioElement = document.getElementById(id);
        if (audioElement.paused) { audioElement.play(); } else { audioElement.pause(); }
    };
</script>

<div class="sd-wrap">
    <div class="container">

        <form class="sd-toolbar" action="~/quran_reading" method="post">
            <div class="sd-field">
                <label>Surah</label>
                <select class="sd-select al-quran" name="ChapterID">
                    @foreach (var item in Model.SuraList)
                    {
                        if (Model.SuraDetail.ChapterID == item.ChapterID)
                        {
                            <option value="@item.ChapterID" selected>@item.ChapterID. &nbsp; @item.SuraName</option>
                        }
                        else
                        {
                            <option value="@item.ChapterID">@item.ChapterID. &nbsp; @item.SuraName</option>
                        }
                    }
                </select>
            </div>
            <div class="sd-field">
                <label>Translation</label>
                <select class="sd-select" name="trans">
                    <option value="Urdu" selected="@(Model.trans == "Urdu" || string.IsNullOrEmpty(Model.trans))">Urdu</option>
                    <option value="English" selected="@(Model.trans == "English")">English</option>
                    <option value="Indonesian" selected="@(Model.trans == "Indonesian")">Indonesian</option>
                    <option value="both" selected="@(Model.trans == "both")">Urdu &amp; English</option>
                </select>
            </div>
            <button type="submit" class="sd-go"><i class="fa fa-search"></i> Go</button>
        </form>

        <div class="sd-head">
            <h1 class="sd-title al-quran">@Model.SuraDetail.SuraName</h1>
            <p class="sd-meta">Surah @Model.SuraDetail.ChapterID &middot; @Model.SuraDetail.EnglishName &middot; <b>@Model.SuraDetail.TotalVerses</b> verses</p>
        </div>

        @{
            if (suraName.Length == 1) { suraName = "00" + suraName; }
            else if (suraName.Length == 2) { suraName = "0" + suraName; }
        }

        <div class="sd-list">
            @foreach (var item in Model.AyatList)
            {
                string id = item.ChapterID + "-" + item.VerseID;
                string original = item.VerseID.ToString();
                string verseName = (original.Length == 1 ? "00" + original : original.Length == 2 ? "0" + original : original) + ".mp3";
                string ayatLink = "/assets/AyatAudios/" + suraName + verseName;

                <div class="sd-ayah" id="@id">
                    <div class="sd-ayah-head">
                        <div class="sd-vmeta">
                            <span class="sd-num">@item.VerseID</span>
                            <a class="sd-audio" onclick="togglePlay('@verseName')" title="Play recitation">
                                <i class="fa fa-volume-up"></i>
                                <audio id="@verseName" src="@ayatLink" preload="none"></audio>
                            </a>
                        </div>
                        <a class="sd-bookmark" onclick="Addookmark('@id')" title="Bookmark this verse">
                            <i class="fa fa-bookmark-o"></i> Bookmark
                        </a>
                    </div>

                    <p class="sd-arabic al-quran al-quran-font-s-2">@item.AyatText</p>

                    @if (Model.trans == "both")
                    {
                        <p class="sd-trans-en">@item.EnglishTranslation</p>
                        <p class="sd-trans-ur">@item.UrduTranslation</p>
                    }
                    else if (Model.trans == "English")
                    {
                        <p class="sd-trans-en">@item.EnglishTranslation</p>
                    }
                    else if (Model.trans == "Indonesian")
                    {
                        <p class="sd-trans-en">@item.IndonasianTranslation</p>
                    }
                    else
                    {
                        <p class="sd-trans-ur">@item.UrduTranslation</p>
                    }
                </div>
            }
        </div>

    </div>
</div>
