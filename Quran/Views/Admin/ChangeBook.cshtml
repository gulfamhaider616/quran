@model Quran.Models.BookDO
@{
    ViewBag.Title = "Edit Book | Learn Quran with E-Tutor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="post" action="/Admin/ChangeBook" enctype="multipart/form-data">
    <div id="banner-wrapper">
        <div id="banner" class="box container">
            <div class="row">
                <div class="col-md-12" style="width:100%;margin:0 auto;overflow-x:auto;">
                    <h4 style="text-align:center">Edit Book Detail</h4>

                    <input type="hidden" name="BookID" value="@Model.BookID" />

                    <table border="0" style="width: 90%;">
                        <tr>
                            <td style="width: 26%;"><label>Book Title<label style="color:red">*</label> :</label></td>
                            <td><input type="text" name="BookTilte" value="@Model.BookTilte" placeholder="enter book name" required /><br /></td>
                        </tr>
                        <tr>
                            <td style="width: 26%;"><label>Author Name<label style="color:red">*</label> :</label></td>
                            <td><input type="text" name="AuthorName" value="@Model.AutherName" placeholder="enter author name" required /><br /></td>
                        </tr>
                        <tr>
                            <td style="width: 26%;"><label>Book Type<label style="color:red">*</label> :</label></td>
                            <td><input type="text" name="BookType" value="@Model.BookType" placeholder="enter book type" required /><br /></td>
                        </tr>
                        <tr>
                            <td><label>Book Picture :</label></td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.ImageName))
                                {
                                    <img src="~/assets/Books/Image/@Model.ImageName" alt="current cover" style="height:70px;border-radius:6px;border:1px solid #e3e8ef;margin-bottom:6px;display:block;" />
                                }
                                <input type="file" name="ImagePath" />
                                <small style="color:#7b8794;">Leave empty to keep the current image.</small>
                                <br />
                            </td>
                        </tr>
                        <tr>
                            <td><label>Book File :</label></td>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.FileName))
                                {
                                    <a href="~/assets/Books/BookFile/@Model.FileName" target="_blank">Current file: @Model.FileName</a>
                                    <br />
                                }
                                <input type="file" name="FilePath" />
                                <small style="color:#7b8794;">Leave empty to keep the current file.</small>
                                <br />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 26%;"><label>Detail:</label></td>
                            <td><textarea style="height:150px;" name="Detail" placeholder="enter book detail" required>@Model.Detail</textarea><br /></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td>
                                <input type="submit" value="Save Changes" />
                                <a href="/Admin/GetAllBooks" style="margin-left:10px;">Cancel</a>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>
