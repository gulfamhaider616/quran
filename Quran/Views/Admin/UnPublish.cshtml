@model IEnumerable<Quran.Models.AskQuestionDO>
@{
    ViewBag.Title = "UnPublish | Learn Quran with E-Tutor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div id="banner-wrapper">
    <div id="banner" class="box container" >
        <div class="row">
            <div class="col-md-12" style="width:100%;margin:0 auto;overflow-x:auto;">
                
                <table class="rest" border="0" style="width: 100%;text-align: center;color: black;font-size: 88%;">
                    <thead style="font-weight: 600;">
                        <tr style="color:white;">
                            <td>Serial</td>
                            <td>Title</td>
                            <td>Action</td>
                        </tr>
                    </thead>
                    <tbody>
                        @{int count = 1; }
                        @foreach (var Item in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td><a href="/Admin/AdminQuestionPreview/@SlugHelper.Make(Item.Subject)" style="text-decoration:none"> @Item.Subject </a></td>
                                <td style="white-space:nowrap;">
                                    <a href="javascript:void(0)" title="Publish" class="btn btn-success btn-sm" onclick='PublishQuestion("@Item.AskQuestionID")'><i class="fa fa-bullhorn"></i></a>
                                    <a href="javascript:void(0)" title="Delete" class="btn btn-danger btn-sm" onclick='confirmAction("Are you sure you want to delete this question?", function(){ DeleteQuestions("@Item.AskQuestionID"); }); return false;'><i class="fa fa-trash-o"></i></a>
                                </td>
                            </tr>
                            count++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

