@{
    ViewBag.Title = "Admin Login | Learn Quran with E-Tutor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="adm-login-wrap">
    <div class="adm-login-card">
        <div class="adm-login-head">
            <img src="~/images/Logo3.png" alt="Learn Quran with E-Tutor" />
            <h2>Admin Login</h2>
            <p>Sign in to manage Learn Free Quran</p>
        </div>
        <form action="/Admin/VerifyAdmin" method="post" class="adm-login-body">
            <div class="adm-field">
                <label>Admin Email</label>
                <input type="text" name="adminname" placeholder="Enter admin email" required />
            </div>
            <div class="adm-field">
                <label>Admin Password</label>
                <input type="password" name="adminpassword" placeholder="Enter admin password" required />
            </div>
            <button type="submit" id="adminlogin" name="adminlogin" class="adm-login-btn">Sign In</button>
        </form>
    </div>
</div>
