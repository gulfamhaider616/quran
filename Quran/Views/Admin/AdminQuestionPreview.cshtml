
@model Quran.Models.AskQuestionDO
@{
    ViewBag.Title = "Learn Free Quran | Learn Quran with E-Tutor";
    ViewBag.Description = "Learn Free Quran is also providing a questions and answers platform when anyone can ask Islamic question. People from whole world are allowed to answer the question. Our qualified team will also answer you in the similar manners.";
    ViewBag.KeyWords = "Forum,LFQ Forum, LFQ question and answers,Ask Question, online Namaz,LFQ Students,LFQ, Learn Free Quran,Quran Tutor,Online Quran";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div id="banner-wrapper">
    <div id="banner" class="box container" >
        <div class="row">
            <div class="col-md-12" style="width:100%;margin:0 auto;overflow-x:auto;">
                <div style="font-size: 159%;color: crimson;">@Model.Subject</div><br />
                <div>@Model.Explanation</div>
                <div style="float:right;">@Model.UserName | @Model.Country</div>
            </div>
        </div>
        <hr style="border-top:solid 1px #e6eaf0;width: 657px;">
        <div class="aqp-actions">
            <a href="javascript:void(0)" class="btn btn-success btn-sm" onclick='PublishQuestion("@Model.AskQuestionID")'><i class="fa fa-bullhorn"></i> Publish</a>
            <a href="javascript:void(0)" class="btn btn-danger btn-sm" onclick='confirmAction("Are you sure you want to delete this question?", function(){ DeleteQuestions("@Model.AskQuestionID"); }); return false;'><i class="fa fa-trash-o"></i> Delete</a>
        </div>
    </div>
</div>

