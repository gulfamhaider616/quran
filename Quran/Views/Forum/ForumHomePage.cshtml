@model IEnumerable<Quran.Models.AskQuestionDO>
@{
    ViewBag.Title = "Islamic Q&A Forum | Learn Quran with E-Tutor";
    ViewBag.Description = "Ask questions about Islam and the Quran and get answers from a qualified team and community. Browse published topics on faith, worship and daily life.";
    ViewBag.KeyWords = "islamic forum, questions answers, ask scholar, faith discussion, worship queries, community help";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var questions = Model?.ToList() ?? new List<Quran.Models.AskQuestionDO>();
}

<div class="fr-section">
    <div class="container">
        <div class="sec-head">
            <span>Questions &amp; Answers</span>
            <h2>Islamic Q&amp;A Forum</h2>
            <p>Ask anything about Islam, the Quran or worship and get clear answers from our qualified team and community.</p>
        </div>

        <div class="fr-bar">
            @if (questions.Any())
            {
                <div class="pg-search">
                    <i class="fa fa-search"></i>
                    <input type="text" placeholder="Search questions..." autocomplete="off"
                           data-search-target="#frList" data-search-items=".fr-item" data-search-empty="#frEmpty" />
                </div>
            }
            <a class="hm-btn fr-bar-ask" href="#" id="askOpen"><i class="fa fa-pencil"></i> Ask a Question</a>
        </div>

        @if (questions.Any())
        {
            <div class="fr-list" id="frList">
                @foreach (var item in questions)
                {
                    <a class="fr-item" href="/Forum/SingleQuestion?QuestionID=@item.AskQuestionID">
                        <span class="fr-icon"><i class="fa fa-comments-o"></i></span>
                        <span class="fr-q">
                            <span class="fr-subject">@item.Subject</span>
                            <span class="fr-meta">by @item.UserName @(string.IsNullOrWhiteSpace(item.Country) ? "" : "· " + item.Country)</span>
                        </span>
                        <i class="fa fa-angle-right fr-arrow"></i>
                    </a>
                }
            </div>
            <div id="frEmpty" class="pg-search-empty">No questions match your search.</div>
        }
        else
        {
            <p class="fr-empty">No questions have been published yet. Be the first to ask!</p>
        }
    </div>
</div>

<div id="askModal" class="modal fr-modal">
    <div class="modal-content">
        <div class="fr-modal-head">
            <h3><i class="fa fa-pencil"></i> Ask a Question</h3>
            <span class="ask-x" id="askClose">&times;</span>
        </div>
        <div class="fr-modal-body">
            @await Html.PartialAsync("_AskQuestionForm")
        </div>
    </div>
</div>

<div id="myModal" class="modal fr-modal">
    <div class="modal-content">
        <div class="fr-modal-msg">
            <span class="close">&times;</span>
            <h5 id="modelheading"></h5>
            <p id="modelparagraph"></p>
        </div>
    </div>
</div>

<script src="~/Scripts/Forum.js"></script>
<script>
    (function () {
        var askModal = document.getElementById('askModal');
        document.getElementById('askOpen').onclick = function (e) {
            e.preventDefault();
            askModal.style.display = 'block';
        };
        document.getElementById('askClose').onclick = function () {
            askModal.style.display = 'none';
        };
        window.addEventListener('click', function (event) {
            if (event.target == askModal) {
                askModal.style.display = 'none';
            }
        });
    })();
</script>
