@model Quran.Models.AskQuestionDO
@{
    ViewBag.Title = "Question and Answer | Learn Quran with E-Tutor";
    ViewBag.Description = "Read a detailed answer to a community question about Islam and the Quran, reviewed by our qualified team to give you trustworthy religious guidance.";
    ViewBag.KeyWords = "answered question, islamic ruling, quran clarification, verified reply, trusted guidance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fr-section">
    <div class="container">
        <div class="fr-single">
            <a class="fr-back" href="/Forum"><i class="fa fa-angle-left"></i> Back to Forum</a>

            <article class="fr-q-card">
                <h1 class="fr-q-title">@Model.Subject</h1>
                <div class="fr-q-meta"><i class="fa fa-user-circle"></i> @Model.UserName @(string.IsNullOrWhiteSpace(Model.Country) ? "" : "· " + Model.Country)</div>
                <div class="fr-q-body">@Model.Explanation</div>
            </article>

            <h4 class="fr-disc-title">Discussion</h4>
            <div id="disqus_thread"></div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>
