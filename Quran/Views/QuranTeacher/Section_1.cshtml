@{
	ViewBag.Title = "Quran Teacher Section 1 - Arabic Alphabets | E-Tutor";

ViewBag.Description = "Begin Quran learning with Section 1: master the Arabic alphabet (Huroof) with correct pronunciation and sound. A free, beginner-friendly first lesson.";
	ViewBag.KeyWords = "arabic alphabets, huroof e tahaji, beginner lesson, letter pronunciation, makhraj basics";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="banner-wrapper">
	<div id="banner" class="box container">
		<div class="row">
			<div class="col-md-12" style="width:100%;margin:0 auto;">
				<div style="text-align:center;">
					<button class="alert-success" style="padding: 0;float: left;width: 18%;font-size: 16px;height: 40px;background: rgb(102, 34, 0);color: white;border-radius: unset;"><a href="/Quran_Teacher" style="color: white;">Instructions</a></button>
					<span style="text-align:center;font-weight:900;font-size: 30px;">Section 1</span>
					<button class="alert-success" style="padding: 0;float: right;width: 18%;font-size: 16px;height: 40px;background: rgb(102, 34, 0);color: white;border-radius: unset;"><a href="online_quran_teacher_section_2" style="color: white;">Next</a></button>
				</div>
				<hr style="border-top:solid 1px #c60;width: 100%;">
				<div class="col-md-3" style="display: inline;text-align: center;">
					<br />

					<a href="javascript:void(0)" id="1" onclick="changeLesson(1)">
						<span style="font-weight:bold;color:rgb(102, 34, 0);">Qurani Lesson 1</span>
						<img src="~/assets/LessonsIcons/1.png" style="border: 1px solid black;max-width: 170px;" />
						
					</a>
					<hr style="margin-bottom: 0;" />

					<a href="javascript:void(0)" id="2" onclick="changeLesson(2)">
						<span style="font-weight:bold;color:rgb(102, 34, 0);">Qurani Lesson 2</span>
						<img src="~/assets/LessonsIcons/2.png" style="border: 1px solid black;max-width: 170px;" />
						
					</a>
					<hr style="margin-bottom: 0;" />

					<a href="javascript:void(0)" id="3" onclick="changeLesson(3)">
						<span style="font-weight:bold;color:rgb(102, 34, 0);">Qurani Lesson 3</span>
						<img src="~/assets/LessonsIcons/3.png" style="border: 1px solid black;max-width: 170px;" />
						
					</a>
					<hr style="margin-bottom: 0;" />
				</div>
				<div class="col-md-9" style="display: inline;">
					<div id="acivelesson">
						<h3 style="text-align: center;" id="lessonname">Listen Carefully Qurani Lesson 1</h3>
						<div id="videodiv">
							<div id="innerdiv">
								<video id="video" width="640" height="480" poster="sample-video.jpg"  controls autoplay preload style="width: 100%;height:100%;border: 1px solid black;">
									<source id="lessonurl" src="~/assets/VideoLessons/Lesson 1.mp4" type="video/mp4">
								</video>
							</div>
						</div>
						
					</div>
					<hr style="border-top:solid 1px #c60;width: 100%;">
					<div id="disqus_thread"></div>
				</div>
			</div>
		</div>
	</div>
