@{
    ViewBag.Title = "Quran Teacher Section 1 - Arabic Alphabets | E-Tutor";
    ViewBag.Description = "Begin Quran learning with Section 1: master the Arabic alphabet (Huroof) with correct pronunciation and sound. A free, beginner-friendly first lesson.";
    ViewBag.KeyWords = "arabic alphabets, huroof e tahaji, beginner lesson, letter pronunciation, makhraj basics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ql-section">
    <div class="container">
        <div class="ql-bar">
            <a class="ql-nav" href="/Quran_Teacher"><i class="fa fa-angle-left"></i> Instructions</a>
            <h2 class="ql-heading">Section 1</h2>
            <a class="ql-nav ql-next" href="online_quran_teacher_section_2">Next <i class="fa fa-angle-right"></i></a>
        </div>

        <div class="ql-grid">
            <div class="ql-lessons">
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(1)">
                    <img src="~/assets/LessonsIcons/1.png" alt="Qurani Lesson 1" />
                    <span>Qurani Lesson 1</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(2)">
                    <img src="~/assets/LessonsIcons/2.png" alt="Qurani Lesson 2" />
                    <span>Qurani Lesson 2</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(3)">
                    <img src="~/assets/LessonsIcons/3.png" alt="Qurani Lesson 3" />
                    <span>Qurani Lesson 3</span>
                </a>
            </div>

            <div class="ql-main">
                <div id="acivelesson">
                    <h3 id="lessonname" class="ql-now">Listen carefully &mdash; Qurani Lesson 1</h3>
                    <div id="videodiv" class="ql-video">
                        <div id="innerdiv">
                            <video id="video" controls autoplay preload>
                                <source id="lessonurl" src="~/assets/VideoLessons/Lesson 1.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
                <h4 class="ql-disc">Discussion</h4>
                <div id="disqus_thread"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>