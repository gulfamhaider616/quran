@{
    ViewBag.Title = "Quran Teacher Section 3 - Vowels and Madd | E-Tutor";
    ViewBag.Description = "Section 3 covers long vowels, Madd, Tanween and Noon Sakin so you pronounce every sound accurately. Free, step-by-step Quran reading practice.";
    ViewBag.KeyWords = "long vowels, madd letters, tanween, noon sakin, accurate pronunciation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ql-section">
    <div class="container">
        <div class="ql-bar">
            <a class="ql-nav" href="online_quran_teacher_section_2"><i class="fa fa-angle-left"></i> Back</a>
            <h2 class="ql-heading">Section 3</h2>
            <a class="ql-nav ql-next" href="online_quran_teacher_section_4">Next <i class="fa fa-angle-right"></i></a>
        </div>

        <div class="ql-grid">
            <div class="ql-lessons">
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(7)">
                    <img src="~/assets/LessonsIcons/7.png" alt="Qurani Lesson 7" />
                    <span>Qurani Lesson 7</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(8)">
                    <img src="~/assets/LessonsIcons/8.png" alt="Qurani Lesson 8" />
                    <span>Qurani Lesson 8</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(9)">
                    <img src="~/assets/LessonsIcons/9.png" alt="Qurani Lesson 9" />
                    <span>Qurani Lesson 9</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(10)">
                    <img src="~/assets/LessonsIcons/10.png" alt="Qurani Lesson 10" />
                    <span>Qurani Lesson 10</span>
                </a>
            </div>

            <div class="ql-main">
                <div id="acivelesson">
                    <h3 id="lessonname" class="ql-now">Listen carefully &mdash; Qurani Lesson 7</h3>
                    <div id="videodiv" class="ql-video">
                        <div id="innerdiv">
                            <video id="video" controls autoplay preload>
                                <source id="lessonurl" src="~/assets/VideoLessons/Lesson 7.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
                <h4 class="ql-disc">Discussion</h4>
                <div id="disqus_thread"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>