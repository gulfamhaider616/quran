@{
    ViewBag.Title = "Quran Teacher Section 5 - Fluent Recitation | E-Tutor";
    ViewBag.Description = "Section 5 helps you achieve fluent, confident recitation through practice and revision of everything you have learned. Free tilawat training online.";
    ViewBag.KeyWords = "fluent recitation, reading practice, revision drills, confident tilawat, speed building";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ql-section">
    <div class="container">
        <div class="ql-bar">
            <a class="ql-nav" href="online_quran_teacher_section_4"><i class="fa fa-angle-left"></i> Back</a>
            <h2 class="ql-heading">Section 5</h2>
            <a class="ql-nav ql-next" href="#">Practice Test <i class="fa fa-angle-right"></i></a>
        </div>

        <div class="ql-grid">
            <div class="ql-lessons">
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(16)">
                    <img src="~/assets/LessonsIcons/16.png" alt="Qurani Lesson 16" />
                    <span>Qurani Lesson 16</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(17)">
                    <img src="~/assets/LessonsIcons/17.png" alt="Qurani Lesson 17" />
                    <span>Qurani Lesson 17</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(18)">
                    <img src="~/assets/LessonsIcons/18.png" alt="Qurani Lesson 18" />
                    <span>Qurani Lesson 18</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(19)">
                    <img src="~/assets/LessonsIcons/19.png" alt="Qurani Lesson 19" />
                    <span>Qurani Lesson 19</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(20)">
                    <img src="~/assets/LessonsIcons/20.png" alt="Qurani Lesson 20" />
                    <span>Qurani Lesson 20</span>
                </a>
            </div>

            <div class="ql-main">
                <div id="acivelesson">
                    <h3 id="lessonname" class="ql-now">Listen carefully &mdash; Qurani Lesson 16</h3>
                    <div id="videodiv" class="ql-video">
                        <div id="innerdiv">
                            <video id="video" controls autoplay preload>
                                <source id="lessonurl" src="~/assets/VideoLessons/Lesson 16.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
                <h4 class="ql-disc">Discussion</h4>
                <div id="disqus_thread"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>