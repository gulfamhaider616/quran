@{
    ViewBag.Title = "Quran Teacher Section 4 - Tajweed Rules | E-Tutor";
    ViewBag.Description = "Learn essential Tajweed rules in Section 4 including Ghunna, Qalqalah and Idgham to recite the Quran beautifully and correctly. Free guided lessons.";
    ViewBag.KeyWords = "tajweed rules, ghunna, qalqalah, idgham, beautiful recitation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ql-section">
    <div class="container">
        <div class="ql-bar">
            <a class="ql-nav" href="online_quran_teacher_section_3"><i class="fa fa-angle-left"></i> Back</a>
            <h2 class="ql-heading">Section 4</h2>
            <a class="ql-nav ql-next" href="online_quran_teacher_section_5">Next <i class="fa fa-angle-right"></i></a>
        </div>

        <div class="ql-grid">
            <div class="ql-lessons">
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(11)">
                    <img src="~/assets/LessonsIcons/11.png" alt="Qurani Lesson 11" />
                    <span>Qurani Lesson 11</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(12)">
                    <img src="~/assets/LessonsIcons/12.png" alt="Qurani Lesson 12" />
                    <span>Qurani Lesson 12</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(13)">
                    <img src="~/assets/LessonsIcons/13.png" alt="Qurani Lesson 13" />
                    <span>Qurani Lesson 13</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(14)">
                    <img src="~/assets/LessonsIcons/14.png" alt="Qurani Lesson 14" />
                    <span>Qurani Lesson 14</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(15)">
                    <img src="~/assets/LessonsIcons/15.png" alt="Qurani Lesson 15" />
                    <span>Qurani Lesson 15</span>
                </a>
            </div>

            <div class="ql-main">
                <div id="acivelesson">
                    <h3 id="lessonname" class="ql-now">Listen carefully &mdash; Qurani Lesson 11</h3>
                    <div id="videodiv" class="ql-video">
                        <div id="innerdiv">
                            <video id="video" controls autoplay preload>
                                <source id="lessonurl" src="~/assets/VideoLessons/Lesson 11.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
                <h4 class="ql-disc">Discussion</h4>
                <div id="disqus_thread"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>