@{
    ViewBag.Title = "Quran Teacher Section 2 - Joining Letters | E-Tutor";
    ViewBag.Description = "Continue with Section 2 and learn how Arabic letters join and change form with harakat. Build your first words on the path to reading the Quran, free.";
    ViewBag.KeyWords = "joining letters, harakat marks, zabar zer pesh, word building, connected forms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="ql-section">
    <div class="container">
        <div class="ql-bar">
            <a class="ql-nav" href="online_quran_teacher_section_1"><i class="fa fa-angle-left"></i> Back</a>
            <h2 class="ql-heading">Section 2</h2>
            <a class="ql-nav ql-next" href="online_quran_teacher_section_3">Next <i class="fa fa-angle-right"></i></a>
        </div>

        <div class="ql-grid">
            <div class="ql-lessons">
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(4)">
                    <img src="~/assets/LessonsIcons/4.png" alt="Qurani Lesson 4" />
                    <span>Qurani Lesson 4</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(5)">
                    <img src="~/assets/LessonsIcons/5.png" alt="Qurani Lesson 5" />
                    <span>Qurani Lesson 5</span>
                </a>
                <a class="ql-lesson" href="javascript:void(0)" onclick="changeLesson(6)">
                    <img src="~/assets/LessonsIcons/6.png" alt="Qurani Lesson 6" />
                    <span>Qurani Lesson 6</span>
                </a>
            </div>

            <div class="ql-main">
                <div id="acivelesson">
                    <h3 id="lessonname" class="ql-now">Listen carefully &mdash; Qurani Lesson 4</h3>
                    <div id="videodiv" class="ql-video">
                        <div id="innerdiv">
                            <video id="video" controls autoplay preload>
                                <source id="lessonurl" src="~/assets/VideoLessons/Lesson 4.mp4" type="video/mp4">
                            </video>
                        </div>
                    </div>
                </div>
                <h4 class="ql-disc">Discussion</h4>
                <div id="disqus_thread"></div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var d = document, s = d.createElement('script');
        s.src = 'https://learnfreequran-1.disqus.com/embed.js';
        s.setAttribute('data-timestamp', +new Date());
        (d.head || d.body).appendChild(s);
    })();
</script>