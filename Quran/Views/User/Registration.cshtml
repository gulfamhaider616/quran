@{
    ViewBag.Title = "Create Account | Learn Quran with E-Tutor";
    ViewBag.Description = "Create your free reader account to bookmark Surahs, save your reading position and continue the Quran where you left off across devices.";
    ViewBag.KeyWords = "create account, reader signup, bookmark surah, save position, cross device access";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-section auth-signup">
    <div class="container">
        <div class="auth-card">
            <div class="auth-top">
                <img src="~/images/Logo3.png" alt="Learn Quran with E-Tutor" />
                <h2>Create Account</h2>
                <p>Bookmark Surahs and save your reading progress</p>
            </div>
            <div class="auth-body">
                <div id="form-messages"></div>
                <form id="contact-form" method="post" action="/User/SaveUser">
                    <div class="auth-field">
                        <i class="fa fa-user"></i>
                        <input type="text" id="name" name="name" placeholder="Full name" required />
                    </div>
                    <div class="auth-field">
                        <i class="fa fa-envelope"></i>
                        <input type="email" id="email" name="email" placeholder="Email address" required />
                    </div>
                    <div class="auth-field">
                        <i class="fa fa-lock"></i>
                        <input type="password" id="password" name="password" placeholder="Create a password" required />
                    </div>
                    <button type="submit" class="auth-btn">Sign Up</button>
                    <div class="auth-switch">
                        Already have an account? <a href="/User/UserLogin">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
