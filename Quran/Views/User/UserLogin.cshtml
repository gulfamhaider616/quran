@{
    ViewBag.Title = "Sign In | Learn Quran with E-Tutor";
    ViewBag.Description = "Sign in to access your saved Quran bookmarks and pick up your recitation exactly where you stopped. Secure, free member login.";
    ViewBag.KeyWords = "user login, member sign in, saved bookmarks, resume reading, secure access";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="auth-section">
    <div class="container">
        <div class="auth-card">
            <div class="auth-top">
                <img src="~/images/Logo3.png" alt="Learn Quran with E-Tutor" />
                <h2>Welcome Back</h2>
                <p>Sign in to continue your Quran reading</p>
            </div>
            <div class="auth-body">
                <form action="/User/VerifyUser" method="post">
                    <div class="auth-field">
                        <i class="fa fa-envelope"></i>
                        <input type="email" name="email" placeholder="Email address" required />
                    </div>
                    <div class="auth-field">
                        <i class="fa fa-lock"></i>
                        <input type="password" name="password" placeholder="Password" required />
                    </div>
                    <button type="submit" class="auth-btn">Sign In</button>
                    <div class="auth-switch">
                        Not registered yet? <a href="/User/Registration">Create an account</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
