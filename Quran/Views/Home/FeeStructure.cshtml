@{
    ViewBag.Title = "Fee Structure & Study Plans | Learn Quran with E-Tutor";
    ViewBag.Description = "Explore our affordable 30-minute Quran class study plans - flexible weekly and monthly packages, a family package and dedicated female teachers for female students.";
    ViewBag.KeyWords = "quran class fees, study plans, monthly packages, affordable classes, family package, female teacher, online quran pricing";
}

<div class="fee-section">
    <div class="container">
        <div class="sec-head">
            <span>Study Plans</span>
            <h2>Choose Your Quran Class Plan</h2>
            <p>Every plan is a 30-minute one-on-one session with a dedicated tutor. Pick the schedule that fits you best and start learning today.</p>
        </div>

        <div class="fee-grid">
            
            <div class="fee-card">
                <span class="fee-plan">Basic</span>
                <div class="fee-price"><small>$</small>35<small>/mo</small></div>
                <div class="fee-sub">8 classes per month</div>
                <ul class="fee-features">
                    <li><span class="tick">&#10003;</span> 2 classes per week</li>
                    <li><span class="tick">&#10003;</span> 8 classes per month</li>
                    <li><span class="tick">&#10003;</span> 30 minutes per class</li>
                    <li><span class="tick">&#10003;</span> One-on-one tutoring</li>
                </ul>
                <a href="/Registration" class="fee-btn">Register Now</a>
            </div>

<div class="fee-card popular">
                <div class="fee-badge">Popular</div>
                <span class="fee-plan">Standard</span>
                <div class="fee-price"><small>$</small>45<small>/mo</small></div>
                <div class="fee-sub">16 classes per month</div>
                <ul class="fee-features">
                    <li><span class="tick">&#10003;</span> 4 classes per week</li>
                    <li><span class="tick">&#10003;</span> 16 classes per month</li>
                    <li><span class="tick">&#10003;</span> 30 minutes per class</li>
                    <li><span class="tick">&#10003;</span> One-on-one tutoring</li>
                </ul>
                <a href="/Registration" class="fee-btn">Register Now</a>
            </div>

<div class="fee-card">
                <span class="fee-plan">Intensive</span>
                <div class="fee-price"><small>$</small>50<small>/mo</small></div>
                <div class="fee-sub">Negotiable &middot; best value</div>
                <ul class="fee-features">
                    <li><span class="tick">&#10003;</span> 5 classes per week</li>
                    <li><span class="tick">&#10003;</span> ~20 classes per month</li>
                    <li><span class="tick">&#10003;</span> 30 minutes per class</li>
                    <li><span class="tick">&#10003;</span> Flexible &amp; negotiable</li>
                </ul>
                <a href="/Registration" class="fee-btn">Register Now</a>
            </div>
        </div>

<div class="fee-family">
            <div class="ff-icon">&#128106;</div>
            <div class="ff-text">
                <h4>Family Package Available</h4>
                <p>Special discounted plans for families enrolling multiple members &mdash; and dedicated female teachers are available for female students.</p>
            </div>
            <a href="/Registration" class="ff-cta">Enquire Now</a>
        </div>

        <p class="fee-note-line">Prices are indicative and may be adjusted for your needs. Contact us for custom or family plans.</p>
    </div>
</div>
