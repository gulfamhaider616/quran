@model IEnumerable<Quran.Models.VideoLessonDO>
@{
    ViewBag.Title = "Quran Video Lessons | Learn Quran with E-Tutor";
    ViewBag.Description = "Watch free Quran video lessons covering recitation, Tajweed and the basics of Islam. Learn at your own pace with clear, structured video tutorials.";
    ViewBag.KeyWords = "quran video lessons, tajweed tutorials, recitation videos, visual learning, self paced";

    var videos = Model?.ToList() ?? new List<Quran.Models.VideoLessonDO>();
    System.Func<string, string> ytId = url =>
    {
        if (string.IsNullOrWhiteSpace(url)) { return ""; }
        var m = System.Text.RegularExpressions.Regex.Match(url, @"(?:v=|youtu\.be/|embed/)([A-Za-z0-9_-]{11})");
        return m.Success ? m.Groups[1].Value : "";
    };
    System.Func<string, bool> isUpload = link =>
        !string.IsNullOrWhiteSpace(link) && link.StartsWith("/assets/Videos/", System.StringComparison.OrdinalIgnoreCase);
}

<div class="vl-section">
    <div class="container">
        <div class="sec-head">
            <span>Learn Visually</span>
            <h2>Quran Video Lessons</h2>
            <p>Watch free, structured video lessons on Quran recitation, Tajweed and the basics of Islam &mdash; learn at your own pace.</p>
        </div>

        @if (videos.Any())
        {
            <div class="pg-search">
                <i class="fa fa-search"></i>
                <input type="text" placeholder="Search lessons..." autocomplete="off"
                       data-search-target="#vlGrid" data-search-items=".vl-card" data-search-empty="#vlEmpty" />
            </div>

            <div class="vl-grid" id="vlGrid">
                @foreach (var v in videos)
                {
                    var id = ytId(v.LessonLink);
                    var upload = isUpload(v.LessonLink);
                    <div class="vl-card" data-search="@v.LessonName">
                        @if (upload)
                        {
                            <div class="vl-thumb vl-local">
                                <video controls preload="metadata" playsinline>
                                    <source src="@v.LessonLink" />
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                        }
                        else
                        {
                            <div class="vl-thumb" data-embed="https://www.youtube.com/embed/@id?autoplay=1&rel=0" onclick="vlPlay(this)">
                                @if (!string.IsNullOrEmpty(id))
                                {
                                    <img src="https://img.youtube.com/vi/@id/hqdefault.jpg" alt="@v.LessonName" loading="lazy" />
                                }
                                <span class="vl-play"><i class="fa fa-play"></i></span>
                            </div>
                        }
                        <div class="vl-body"><h4>@v.LessonName</h4></div>
                    </div>
                }
            </div>
            <div id="vlEmpty" class="pg-search-empty">No lessons match your search.</div>
        }
        else
        {
            <p style="text-align:center;color:#8b95a3;padding:46px 0;">No video lessons available yet. Please check back soon.</p>
        }
    </div>
</div>

<script>
    function vlPlay(el) {
        var src = el.getAttribute('data-embed');
        if (!src || el.classList.contains('is-playing')) { return; }
        var f = document.createElement('iframe');
        f.setAttribute('src', src);
        f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        f.setAttribute('allowfullscreen', '');
        f.className = 'vl-iframe';
        el.innerHTML = '';
        el.appendChild(f);
        el.classList.add('is-playing');
    }
</script>
