
@{
    ViewBag.Title = "Recover Student ID | Learn Quran with E-Tutor";
    ViewBag.Description = "Forgot your student ID? Retrieve it instantly using your registered email and regain access to your class schedule and profile information.";
    ViewBag.KeyWords = "forgot student id, recover account, retrieve id, registered email, id lookup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="banner-wrapper">
    <div id="banner" class="box container" >
        <div class="row">
            <div class="col-md-12" style="width:120%;margin:0 auto;overflow-x:auto;">
                <h3 style="text-align:center;">Find your Student ID here.</h3>
                <form action="#" method="post">
                    <table border="0" style="width: 90%;">
                        <tr>
                            <td><label>Enter Email<label style="color:red">*</label> :</label></td>
                            <td>
                                <input type="text" style="width: 100% !important;max-width: 100%;" id="forgetemailid" placeholder="enter student email id" required /><br />
                            </td>
                            <td><input type="button" id="studentforgetbutton" class="btn-success"  value="Check" /></td>
                        </tr>
                    </table>
                </form>
            </div>
        </div>
    </div>
</div>

