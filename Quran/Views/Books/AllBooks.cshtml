@model IEnumerable<Quran.Models.BookDO>
@{
    ViewBag.Title = "Islamic Books Library | Learn Quran with E-Tutor";
    ViewBag.Description = "Browse, read and download a curated collection of free Islamic books and PDFs on the Quran, Seerah, Hadith and Fiqh. Authentic literature to grow your knowledge.";
    ViewBag.KeyWords = "islamic books, free pdf download, read online, seerah literature, hadith collection, fiqh guides, religious library";

    var books = Model?.ToList() ?? new List<Quran.Models.BookDO>();
    var types = books.Select(b => b.BookType)
                     .Where(t => !string.IsNullOrWhiteSpace(t))
                     .Select(t => t.Trim())
                     .Distinct(System.StringComparer.OrdinalIgnoreCase)
                     .OrderBy(t => t).ToList();
}

<div class="ib-section">
    <div class="container">
        <div class="sec-head">
            <span>Islamic Library</span>
            <h2>Free Islamic Books</h2>
            <p>Read online or download authentic books on the Quran, Seerah, Hadith and Fiqh &mdash; completely free.</p>
        </div>

        @if (books.Any())
        {
            <div class="ib-toolbar">
                <div class="ib-search">
                    <i class="fa fa-search ic"></i>
                    <input type="text" id="ibSearch" placeholder="Search by title or author..." autocomplete="off" />
                </div>
                @if (types.Any())
                {
                    <div class="ib-filter">
                        <select id="ibType">
                            <option value="">All categories</option>
                            @foreach (var t in types)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    </div>
                }
            </div>

            <div class="ib-grid" id="ibGrid">
                @foreach (var book in books)
                {
                    <article class="ib-card" data-title="@book.BookTilte" data-author="@book.AutherName" data-type="@book.BookType">
                        <div class="ib-cover">
                            @if (!string.IsNullOrWhiteSpace(book.BookType))
                            {
                                <span class="ib-type">@book.BookType</span>
                            }
                            <img src="~/assets/Books/Image/@book.ImageName" alt="@book.BookTilte"
                                 onerror="this.onerror=null;this.src='/assets/Books/Image/no-cover.svg';" />
                        </div>
                        <div class="ib-body">
                            <h3 class="ib-title">@book.BookTilte</h3>
                            <p class="ib-author">by @book.AutherName</p>
                            <p class="ib-detail">@book.Detail</p>
                        </div>
                        <div class="ib-actions">
                            @if (!string.IsNullOrEmpty(book.FileName))
                            {
                                <a class="ib-btn ib-read" href="/assets/Books/BookFile/@book.FileName" target="_blank" rel="noopener"><i class="fa fa-book"></i> Read</a>
                                <a class="ib-btn ib-dl" href="/assets/Books/BookFile/@book.FileName" download><i class="fa fa-download"></i> Download</a>
                            }
                            else
                            {
                                <span class="ib-disabled">Coming soon</span>
                            }
                        </div>
                    </article>
                }
            </div>
            <div id="ibEmpty" class="ib-empty" style="display:none;">No books match your search.</div>
        }
        else
        {
            <div class="ib-empty">No books available yet. Please check back soon.</div>
        }
    </div>
</div>

<script>
    (function () {
        var s = document.getElementById('ibSearch'),
            t = document.getElementById('ibType'),
            grid = document.getElementById('ibGrid'),
            empty = document.getElementById('ibEmpty');
        if (!grid) return;
        var cards = [].slice.call(grid.querySelectorAll('.ib-card'));
        function apply() {
            var q = (s && s.value ? s.value : '').toLowerCase().trim(),
                ty = (t && t.value ? t.value : '').toLowerCase();
            var shown = 0;
            cards.forEach(function (c) {
                var hay = ((c.getAttribute('data-title') || '') + ' ' + (c.getAttribute('data-author') || '')).toLowerCase();
                var okText = !q || hay.indexOf(q) > -1;
                var okType = !ty || (c.getAttribute('data-type') || '').toLowerCase() === ty;
                var show = okText && okType;
                c.style.display = show ? '' : 'none';
                if (show) shown++;
            });
            if (empty) empty.style.display = shown ? 'none' : 'block';
        }
        if (s) s.addEventListener('input', apply);
        if (t) t.addEventListener('change', apply);
    })();
</script>
